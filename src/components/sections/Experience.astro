---
const roles = [
    {
        role: 'Software Developer',
        org: 'TIHLDE',
        location: 'Trondheim',
        period: 'Sept 2023 – Present',
        highlights: [
            'Working as a fullstack developer for my student organization',
            'Developed a standalone item booking solution with a small team',
            'Maintaining core infrastructure and legacy systems',
            'Developing a new backend solution architecture'
        ]
    }
]
---

<section id="experience" class="flex flex-col gap-4">
    <h2 class="section-title">Experience</h2>
    <div class="space-y-3">
        {
            roles.map((r) => (
                <div class="bg-card text-card-foreground rounded-xl ring-1 ring-foreground/10 shadow-xs overflow-hidden">
                    <div class="px-5 pt-5 pb-4">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <p class="font-semibold text-sm leading-snug">{r.role}</p>
                                <p class="text-muted-foreground text-sm mt-0.5">
                                    {r.org} · {r.location}
                                </p>
                            </div>
                            <span class="text-muted-foreground text-xs whitespace-nowrap mt-0.5">
                                {r.period}
                            </span>
                        </div>
                        <ul class="mt-3 space-y-1 text-sm text-muted-foreground list-disc pl-4">
                            {r.highlights.map((h) => (
                                <li>{h}</li>
                            ))}
                        </ul>
                    </div>
                </div>
            ))
        }
    </div>
</section>
