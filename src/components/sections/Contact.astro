---
const email = 'conrad.tinius.osvik@gmail.com'
const socials = [{ name: 'GitHub', href: 'https://github.com/ConradOsvik' }]
---

<section id="contact" class="flex flex-col gap-4">
    <h2 class="section-title">Contact</h2>
    <p class="text-muted-foreground text-sm">
        Want to collaborate or just say hi? Reach out:
    </p>
    <div class="flex flex-col gap-2 text-sm">
        <a
            href={`mailto:${email}`}
            class="text-foreground underline underline-offset-4 hover:opacity-70 transition-opacity w-fit"
        >
            {email}
        </a>
        <div class="flex gap-4">
            {
                socials.map((s) => (
                    <a
                        href={s.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-foreground underline underline-offset-4 hover:opacity-70 transition-opacity"
                    >
                        {s.name}
                    </a>
                ))
            }
        </div>
    </div>
</section>
