---
const year = new Date().getFullYear()
---

<footer class="w-full py-6">
    <div class="mx-auto w-full max-w-xl px-6 md:px-0">
        <div
            class="text-muted-foreground flex flex-col gap-4 text-sm sm:flex-row sm:items-center sm:justify-between"
        >
            <p class="text-center sm:text-left">© {year} Conrad Osvik</p>
            <div
                class="flex items-center justify-center gap-6 sm:justify-end"
            >
                <a
                    href="/#projects"
                    class="hover:text-foreground transition-colors hover:underline"
                >
                    Projects
                </a>
                <a
                    href="/#contact"
                    class="hover:text-foreground transition-colors hover:underline"
                >
                    Contact
                </a>
            </div>
        </div>
    </div>
</footer>
