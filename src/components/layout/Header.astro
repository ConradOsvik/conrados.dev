---
import Logo from '~/components/ui/logo'
import { ThemeToggle } from '~/components/layout/ThemeToggle'
import { NavLinks } from '~/components/layout/NavLinks'

const pathname = Astro.url.pathname
---

<header class="sticky top-0 z-50 w-full backdrop-blur-sm bg-background/60 dark:bg-background/80">
    <!-- Diffused bottom border -->
    <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-border/50 to-transparent"
    />
    <div
        class="relative mx-auto flex w-full max-w-xl items-center justify-between px-6 py-3 md:px-0"
    >
        <div class="flex items-center gap-3">
            <a href="/" class="flex items-center rounded-sm outline-none focus-visible:ring-2 focus-visible:ring-ring/50">
                <Logo
                    size={32}
                />
            </a>
            <NavLinks pathname={pathname} client:load />
        </div>
        <div class="flex items-center">
            <ThemeToggle client:load />
        </div>
    </div>
</header>
