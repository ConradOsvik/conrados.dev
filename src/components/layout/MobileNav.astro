---
const pathname = Astro.url.pathname

function isActive(href: string) {
    if (href === '/') return pathname === '/'
    return pathname === href || pathname.startsWith(href + '/')
}
---

<nav
    class="bg-foreground/95 dark:supports-[backdrop-filter]:bg-foreground/10 supports-[backdrop-filter]:bg-foreground/10 fixed bottom-4 left-1/2 flex -translate-x-1/2 items-center justify-center gap-2 rounded-full p-2 backdrop-blur md:hidden"
>
    <a
        href="/"
        class:list={[
            'rounded-full px-4 py-2 font-medium transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring/50',
            isActive('/')
                ? 'bg-foreground/10 text-foreground'
                : 'bg-foreground/0 text-muted-foreground hover:text-foreground'
        ]}
    >
        Home
    </a>
    <a
        href="/blog"
        class:list={[
            'rounded-full px-4 py-2 font-medium transition-colors outline-none focus-visible:ring-2 focus-visible:ring-ring/50',
            isActive('/blog')
                ? 'bg-foreground/10 text-foreground'
                : 'bg-foreground/0 text-muted-foreground hover:text-foreground'
        ]}
    >
        Blog
    </a>
</nav>
