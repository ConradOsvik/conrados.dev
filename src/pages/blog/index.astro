---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import Layout from '~/layouts/Layout.astro'

const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
)
---

<Layout
    title="Blog – Conrad Osvik"
    description="Writing about software, engineering, and things I find interesting."
>
    <div class="flex w-full max-w-xl flex-col py-8 gap-8">
        <div>
            <p class="section-title mb-1">Writing</p>
            <h1 class="typo-headline-md">Blog</h1>
        </div>

        {
            posts.length === 0 ? (
                <p class="typo-body-md">No posts yet. Check back soon!</p>
            ) : (
                <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2">
                    {posts.map((post) => (
                        <a href={`/blog/${post.slug}`} class="group block">
                            <article class="bg-card rounded-xl ring-1 ring-foreground/10 shadow-xs overflow-hidden transition-shadow hover:shadow-md">
                                {post.data.cover && (
                                    <div class="aspect-video overflow-hidden">
                                        <Image
                                            src={post.data.cover}
                                            alt={post.data.title}
                                            width={480}
                                            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                                        />
                                    </div>
                                )}
                                <div class="p-4 space-y-2">
                                    <h2 class="font-semibold text-sm leading-snug line-clamp-2">
                                        {post.data.title}
                                    </h2>
                                    <p class="text-muted-foreground text-xs leading-relaxed line-clamp-2">
                                        {post.data.description}
                                    </p>
                                    <div class="flex items-center justify-between pt-1">
                                        <time
                                            class="text-muted-foreground text-xs"
                                            datetime={post.data.date.toISOString()}
                                        >
                                            {post.data.date.toLocaleDateString(
                                                'en',
                                                {
                                                    year: 'numeric',
                                                    month: 'short',
                                                    day: 'numeric'
                                                }
                                            )}
                                        </time>
                                        {post.data.tags && post.data.tags.length > 0 && (
                                            <div class="flex gap-1">
                                                {post.data.tags.slice(0, 2).map((tag) => (
                                                    <span class="bg-muted text-muted-foreground rounded-full px-2 py-0.5 text-xs">
                                                        {tag}
                                                    </span>
                                                ))}
                                            </div>
                                        )}
                                    </div>
                                </div>
                            </article>
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</Layout>
