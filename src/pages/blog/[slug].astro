---
import { getImage } from 'astro:assets'
import { getCollection } from 'astro:content'
import Layout from '~/layouts/Layout.astro'
import PostHeader from '~/components/blog/PostHeader.astro'
import TableOfContents from '~/components/blog/TableOfContents.astro'
import { mdxComponents } from '~/components/mdx/index'

export async function getStaticPaths() {
    const posts = await getCollection('blog')
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post }
    }))
}

const { post } = Astro.props
const { Content, headings } = await post.render()

// Generate a 1200px-wide JPEG for the og:image tag.
// getImage() runs at build time — the result.src is the hashed output path.
// Combining with Astro.site gives a fully-qualified URL that crawlers expect.
const ogImageData = post.data.cover
    ? await getImage({ src: post.data.cover, width: 1200, format: 'jpeg' })
    : null
const ogImageUrl = ogImageData ? new URL(ogImageData.src, Astro.site).href : undefined
const ogImageHeight = ogImageData?.attributes.height as number | undefined
---

<Layout
    title={`${post.data.title} – Conrad Osvik`}
    description={post.data.description}
    ogImage={ogImageUrl}
    ogImageHeight={ogImageHeight}
    ogType="article"
>
    <div class="w-full max-w-xl py-8">
        <article class="relative">
            <PostHeader post={post} />
            <div class="prose max-w-none">
                <Content components={mdxComponents} />
            </div>
            <!-- TOC floats to the right without affecting content centering.
                 bottom-0 stretches aside to full article height so sticky works. -->
            <aside class="hidden 2xl:block absolute left-full top-0 bottom-0 ml-12 w-52">
                <div class="sticky top-24">
                    <TableOfContents headings={headings} />
                </div>
            </aside>
        </article>
    </div>
</Layout>
